# Local development only. Replace the example password locally; never use it in production.
POSTGRES_DB=tdop_dev
POSTGRES_USER=tdop_dev
POSTGRES_PASSWORD=replace-me-local-only
POSTGRES_PORT=5432
SERVER_PORT=8080
VITE_DEV_PORT=5173
VITE_API_BASE_URL=/api/v1

# --- Database (D-017) -------------------------------------------------------
# The backend reads its datasource from the environment only; nothing here is
# committed with a real credential. The defaults already match docker-compose,
# so the block below is only needed to point at a different PostgreSQL.
# TDOP_DB_URL=jdbc:postgresql://127.0.0.1:5432/tdop_dev
# TDOP_DB_USERNAME=tdop_dev
# TDOP_DB_PASSWORD=replace-me-local-only

# Test database used by `backend-test` / `./mvnw -B verify`.
# Defaults: TDOP_TEST_DB_URL=jdbc:postgresql://127.0.0.1:5432/tdop_test
#           TDOP_TEST_DB_USERNAME=tdop_app, password taken from TDOP_DB_PASSWORD.
# TDOP_TEST_DB_URL=jdbc:postgresql://127.0.0.1:5432/tdop_test
# TDOP_TEST_DB_USERNAME=tdop_app
# TDOP_TEST_DB_PASSWORD=replace-me-local-only

# Uncomment to load development seed data on startup, or use `make backend-run-seed`
# / `scripts\dev.ps1 -Task backend-run-seed`. Seed data never runs without this profile.
# SPRING_PROFILES_ACTIVE=seed
